<Window x:Class="EasyBalance.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyBalance" Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,25,18,32">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="E" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="EasyBalance" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Network routing" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="24,0,0,10" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="{Binding IsDashboardActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" /><TextBlock Text="Dashboard" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Rules" Tag="{Binding IsRulesActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" /><TextBlock Text="Application rules" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Interfaces" Tag="{Binding IsInterfacesActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" /><TextBlock Text="Interfaces" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Failover" Tag="{Binding IsFailoverActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" /><TextBlock Text="Failover" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Logs" Tag="{Binding IsLogsActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" /><TextBlock Text="Logs" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,20">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.55" Margin="8,0,8,15" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Advanced" Tag="{Binding IsAdvancedActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" /><TextBlock Text="Advanced" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" Tag="{Binding IsDiagnosticsActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" /><TextBlock Text="Diagnostics" VerticalAlignment="Center" /></StackPanel></Button>
                    <TextBlock Text="Local control only" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="11" Margin="16,19,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,34,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPage.Title}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentPage.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ConnectionLabel, Converter={StaticResource HealthBrushConverter}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Content="&#xE72C;  Refresh" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" Content="{Binding ThemeButtonText}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="EasyBalance · The service keeps running when this window closes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="IPv4 and IPv6 are monitored independently" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
