<Window x:Class="EasyBalance.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyBalance" Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,24,18,30">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#356AE6" VerticalAlignment="Center">
                            <TextBlock Text="E" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="EasyBalance" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Network routing" Foreground="#9EADC2" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#8595AB" FontSize="10" FontWeight="Bold" Margin="22,0,0,8" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="{Binding IsDashboardActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="17" Width="27" /><TextBlock Text="Dashboard" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Rules" Tag="{Binding IsRulesActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="16" Width="27" /><TextBlock Text="Application rules" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Interfaces" Tag="{Binding IsInterfacesActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="⇄" FontSize="17" Width="27" /><TextBlock Text="Interfaces" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Failover" Tag="{Binding IsFailoverActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="⟳" FontSize="17" Width="27" /><TextBlock Text="Failover" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Logs" Tag="{Binding IsLogsActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="≡" FontSize="18" Width="27" /><TextBlock Text="Logs" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,20">
                    <Border Height="1" Background="#344257" Margin="4,0,4,16" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Advanced" Tag="{Binding IsAdvancedActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="27" /><TextBlock Text="Advanced" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" Tag="{Binding IsDiagnosticsActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="16" Width="27" /><TextBlock Text="Diagnostics" VerticalAlignment="Center" /></StackPanel></Button>
                    <TextBlock Text="Local control only" Foreground="#8E9CB0" FontSize="11" Margin="14,20,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,20,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPage.Title}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentPage.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="11,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Content="↻  Refresh" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" Content="{Binding ThemeButtonText}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="EasyBalance UI · The service and routing continue when this window closes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="IPv4 and IPv6 are monitored independently" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
