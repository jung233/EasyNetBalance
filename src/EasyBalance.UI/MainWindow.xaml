<Window x:Class="EasyBalance.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyBalance" Width="1460" Height="900" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="214" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,15,26">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"><TextBlock Text="E" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="EasyBalance" Foreground="White" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="NETWORK CONTROL" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,3,0,0" /></StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,18">
                    <Border Height="1" Background="{DynamicResource SidebarMutedTextBrush}" Opacity="0.28" Margin="12,0,12,13" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Advanced" Tag="{Binding IsAdvancedActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" /><TextBlock Text="Settings" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" Tag="{Binding IsDiagnosticsActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" /><TextBlock Text="Diagnostics" /></StackPanel></Button>
                    <TextBlock Text="Local service control" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="10" Margin="16,14,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="OVERVIEW" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="23,0,0,8" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="{Binding IsDashboardActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" /><TextBlock Text="Overview" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Traffic" Tag="{Binding IsTrafficActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" /><TextBlock Text="Live traffic" /></StackPanel></Button>
                    <TextBlock Text="CONFIGURE" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="23,25,0,8" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Rules" Tag="{Binding IsRulesActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" /><TextBlock Text="Application rules" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Interfaces" Tag="{Binding IsInterfacesActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" /><TextBlock Text="Interfaces" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Failover" Tag="{Binding IsFailoverActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" /><TextBlock Text="Policies &amp; failover" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Logs" Tag="{Binding IsLogsActive}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" /><TextBlock Text="Event log" /></StackPanel></Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="25,22,25,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding CurrentPage.Title}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentPage.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding ConnectionLabel, Converter={StaticResource HealthBrushConverter}}" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="{Binding ConnectionLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" /></StackPanel></Border>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Content="Refresh" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" Content="{Binding ThemeButtonText}" />
                </StackPanel>
            </Grid>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
            <TextBlock Grid.Row="2" Text="EasyBalance · Service continues after this window closes" Margin="0,12,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
