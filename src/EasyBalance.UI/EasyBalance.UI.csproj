<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyBalance.Shared\EasyBalance.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(PublishRoot)\Service\EasyBalance.Service.exe')">
    <EmbeddedResource Include="$(PublishRoot)\Service\EasyBalance.Service.exe" LogicalName="EasyBalance.Payload.Service.exe" />
    <EmbeddedResource Include="$(PublishRoot)\Service\core\sing-box.exe" LogicalName="EasyBalance.Payload.core.sing-box.exe" Condition="Exists('$(PublishRoot)\Service\core\sing-box.exe')" />
  </ItemGroup>
</Project>
