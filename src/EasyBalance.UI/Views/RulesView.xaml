<UserControl x:Class="EasyBalance.UI.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,8">

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search application, executable path, or policy" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddRunningProcessCommand}" Content="Add running process" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddCommand}" Content="Browse EXE" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="Refresh" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
            <DataGrid ItemsSource="{Binding VisibleRules}" RowHeight="46" Height="340" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="160" />
                    <DataGridTextColumn Header="Executable" Binding="{Binding ExecutablePath}" Width="2*" />
                    <DataGridTextColumn Header="Policy" Binding="{Binding PolicyName}" Width="150" />
                    <DataGridTextColumn Header="IPv4 route" Binding="{Binding IPv4Route}" Width="130" />
                    <DataGridTextColumn Header="IPv6 route" Binding="{Binding IPv6Route}" Width="130" />
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="75" />
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70" />
                    <DataGridTemplateColumn Header="Actions" Width="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Padding="8,4" Content="Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource SecondaryButton}" Padding="8,4" Content="{Binding ToggleText}" Margin="5,0,0,0" Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource SecondaryButton}" Padding="8,4" Content="Remove" Margin="5,0,0,0" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
            <Grid DataContext="{Binding Draft}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Application rule" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Display name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Executable path" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse" Padding="10,5" Margin="6,0,0,0" Click="BrowseExecutable_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,10,0">
                    <TextBlock Text="Routing policy" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding DataContext.PolicyOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PolicyId}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Priority" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <TextBox Width="80" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,13,0,0">
                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Full executable paths match before generic process names." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,13,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Save rule" Command="{Binding DataContext.SaveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Visibility="{Binding IsProcessPickerOpen, Converter={StaticResource BoolVisibility}}"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Choose a running application" FontSize="15" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding RunningProcesses}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="DisplayName" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Use process" Command="{Binding UseProcessCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Close" Command="{Binding CloseProcessPickerCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,9,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
</UserControl>
