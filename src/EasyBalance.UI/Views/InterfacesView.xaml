<UserControl x:Class="EasyBalance.UI.Views.InterfacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,8">
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Select an interface to inspect addresses, health, and probe timing." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Show virtual interfaces" IsChecked="{Binding ShowVirtualInterfaces}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleVirtualCommand}" Content="Save view preference" Padding="10,6" Margin="10,0,0,0" />
            </StackPanel>
            <Button Grid.Row="1" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="Refresh interfaces" HorizontalAlignment="Right" />
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
            <DataGrid ItemsSource="{Binding VisibleAdapters}" SelectedItem="{Binding SelectedAdapter}" RowHeight="44" Height="300" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Interface" Binding="{Binding Name}" Width="190" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" />
                    <DataGridTextColumn Header="Link" Binding="{Binding OperationalStatus}" Width="90" />
                    <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="100" />
                    <DataGridTextColumn Header="IPv4 health" Binding="{Binding IPv4Health}" Width="115" />
                    <DataGridTextColumn Header="IPv6 health" Binding="{Binding IPv6Health}" Width="115" />
                    <DataGridTextColumn Header="IPv4 latency" Binding="{Binding IPv4LatencyText}" Width="100" />
                    <DataGridTextColumn Header="IPv6 latency" Binding="{Binding IPv6LatencyText}" Width="100" />
                    <DataGridTemplateColumn Header="Internet use" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Content="{Binding UseActionText}" Padding="8,4"
                                        Command="{Binding DataContext.ToggleUsabilityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,12,0,0">
            <Grid DataContext="{Binding SelectedAdapter}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Test IPv4" Command="{Binding DataContext.TestSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="IPv4" Margin="0,0,7,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Test IPv6" Command="{Binding DataContext.TestSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="IPv6" Margin="0,0,7,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Test both" Command="{Binding DataContext.TestSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Both" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="IPv4 addresses" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding IPv4Addresses}" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv4Addresses}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding IPv4Gateways, StringFormat='Gateway: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv4Gateways}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="IPv6 addresses" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding IPv6Addresses}" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv6Addresses}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding IPv6Gateways, StringFormat='Default route: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv6Gateways}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                        <TextBlock Text="Health timing" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LastProbeText, StringFormat='Last probe: {0}'}" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LastStateChangeText, StringFormat='Last state change: {0}'}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,9,0,0">
            <TextBlock Text="{Binding TestResult}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
</UserControl>
