<UserControl x:Class="EasyBalance.UI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PauseCommand}" Content="{Binding PauseButtonText}" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" Content="Clear view" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyCommand}" Content="Copy" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenDirectoryCommand}" Content="Open log directory" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Content="Refresh logs" HorizontalAlignment="Right" />
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
            <DataGrid ItemsSource="{Binding Entries}" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="175" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="105" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="145" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
