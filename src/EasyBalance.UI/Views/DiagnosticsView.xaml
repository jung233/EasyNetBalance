<UserControl x:Class="EasyBalance.UI.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="0.9*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Resource and routing metrics" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Measurements are collected when you refresh this page. Connection details stay local." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Refresh diagnostics" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="8">
            <DataGrid ItemsSource="{Binding Metrics}" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="250" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Active connections" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding ConnectionTelemetryStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding TelemetryLastError, StringFormat='Telemetry LastError · {0}'}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding TelemetryLastError}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTelemetryLastError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding OutboundTelemetryStatus}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding OutboundTraffic}" RowHeight="30" MaxHeight="105" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Outbound" Binding="{Binding Name}" Width="150" />
                        <DataGridTemplateColumn Header="Availability" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="OutboundStatus" Text="{Binding AvailabilityText}" VerticalAlignment="Center" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                            <Setter TargetName="OutboundStatus" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="OutboundStatus" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Error" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="OutboundError" Text="{Binding ErrorText}" ToolTip="{Binding ErrorText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ErrorText}" Value="Unknown">
                                            <Setter TargetName="OutboundError" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter TargetName="OutboundError" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="OutboundError" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding ActiveConnections}" RowHeight="34" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Process" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Process}" ToolTip="{Binding ProcessPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Destination IP" Binding="{Binding DestinationIp}" Width="125" />
                        <DataGridTextColumn Header="Port" Binding="{Binding DestinationPort}" Width="65" />
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="150" />
                        <DataGridTextColumn Header="Network" Binding="{Binding Network}" Width="80" />
                        <DataGridTextColumn Header="Actual outbound" Binding="{Binding ActualOutbound}" Width="135" />
                        <DataGridTextColumn Header="Predicted outbound" Binding="{Binding PredictedOutbound}" Width="145" />
                        <DataGridTextColumn Header="Uploaded" Binding="{Binding UploadText}" Width="100" />
                        <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadText}" Width="105" />
                        <DataGridTextColumn Header="Started" Binding="{Binding StartedAtText}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="Raw service diagnostics" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Text="{Binding DiagnosticsJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,9,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
