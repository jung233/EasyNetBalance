<UserControl x:Class="EasyBalance.UI.Views.FailoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Routing policy" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Health thresholds and failback are evaluated independently for IPv4 and IPv6." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <ComboBox Width="240" ItemsSource="{Binding Policies}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPolicy}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Add policy" Command="{Binding AddPolicyCommand}" Margin="7,0,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Delete" Command="{Binding DeletePolicyCommand}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid DataContext="{Binding SelectedPolicy}" Margin="0,17,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Policy name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Primary interface" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding DataContext.InterfaceOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PrimaryInterfaceId}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,12,0">
                            <TextBlock Text="Fallback interface" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding DataContext.FallbackOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FallbackInterfaceId}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                            <CheckBox Content="Failover enabled" IsChecked="{Binding FailoverEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,9" />
                            <CheckBox Content="Automatic failback" IsChecked="{Binding AutoFailback}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,15,0,0">
                            <CheckBox Content="Policy enabled" IsChecked="{Binding Enabled}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.8*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Traffic balancing" FontSize="14" FontWeight="SemiBold" />
                                <CheckBox Content="Enable load balancing on the default policy" IsChecked="{Binding SelectedPolicy.LoadBalanceEnabled, Mode=TwoWay}" IsEnabled="{Binding IsSelectedDefaultPolicy}" Margin="0,10,0,0" />
                                <TextBlock Text="Only the current default routing policy can enable this feature." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Primary interface traffic target" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPolicy.PrimaryTrafficPercent, StringFormat='{}{0}%'}" FontSize="15" FontWeight="SemiBold" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding IsSelectedDefaultPolicy}" Value="{Binding SelectedPolicy.PrimaryTrafficPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding SelectedPolicy.RemainingTrafficPercent, StringFormat='Remaining target · {0}%'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="0%" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="100%" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="Only the default policy's primary and fallback WAN can be balanced. Save this policy here, or use Live traffic for immediate adjustments. Existing flows stay on their exit." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Failure threshold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding SelectedPolicy.FailureThreshold, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Recovery threshold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding SelectedPolicy.RecoveryThreshold, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,10,0"><TextBlock Text="Recovery stabilization (s)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding SelectedPolicy.RecoveryStabilization, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,10,0"><TextBlock Text="Minimum switch hold (s)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding SelectedPolicy.MinimumSwitchHoldTime, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Save policy" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Test all" Command="{Binding DataContext.TestAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Set default" Command="{Binding DataContext.SetDefaultPolicyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TestSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Health probe schedule" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Use slower checks while healthy and faster checks during recovery." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Save timing and endpoints" Command="{Binding SaveEndpointsCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,14,0,15">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Healthy interval (s)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding HealthyProbeInterval, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Suspect interval (s)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding SuspectProbeInterval, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,12,0"><TextBlock Text="Down recovery (s)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding DownProbeInterval, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"><TextBlock Text="Probe timeout (s)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" /><TextBox Text="{Binding ProbeTimeout, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedEndpoint}" Height="154" RowHeight="36" ColumnHeaderHeight="32" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                            <DataGridTextColumn Header="HTTPS endpoint" Binding="{Binding Url}" Width="*" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80" />
                            <DataGridCheckBoxColumn Header="IPv4" Binding="{Binding RequireIPv4}" Width="70" />
                            <DataGridCheckBoxColumn Header="IPv6" Binding="{Binding RequireIPv6}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Margin="0,10,0,0" DataContext="{Binding SelectedEndpoint}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,9,0" ToolTip="Endpoint name" />
                        <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,9,0" ToolTip="HTTPS probe URL" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Add" Command="{Binding DataContext.AddEndpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Remove" Command="{Binding DataContext.RemoveEndpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
