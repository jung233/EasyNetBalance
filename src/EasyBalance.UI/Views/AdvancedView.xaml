<UserControl x:Class="EasyBalance.UI.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="19">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Routing configuration" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Changes are validated and applied by EasyBalance Service." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleRoutingCommand}" Content="{Binding ToggleRoutingText}" HorizontalAlignment="Right" />
                    </Grid>
                    <WrapPanel Margin="0,16,0,8">
                        <CheckBox Content="Enable IPv6 routing" IsChecked="{Binding IPv6Enabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,12" />
                        <CheckBox Content="Use strict route" IsChecked="{Binding StrictRoute}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,12" />
                        <CheckBox Content="Disconnect old connections on failover" IsChecked="{Binding DisconnectOldConnections}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,12" />
                        <CheckBox Content="Show virtual interfaces" IsChecked="{Binding ShowVirtualInterfaces}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,12" />
                    </WrapPanel>
                    <TextBlock Text="sing-box executable path" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SingBoxPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse" Click="BrowseSingBox_Click" Margin="7,0,0,0" />
                    </Grid>
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Detected sing-box version" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DetectedVersion}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Validate config" Command="{Binding ValidateCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Restart core" Command="{Binding RestartCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Open data directory" Command="{Binding OpenDataDirectoryCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Diagnostics export" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Create a local archive for troubleshooting. The service redacts its control secret." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="Redact IP addresses" IsChecked="{Binding RedactIpAddresses}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Choose a local destination after the service prepares the archive." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Generated sing-box config" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Read-only view with control credentials removed." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="View generated config" Command="{Binding ShowConfigCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBox Text="{Binding GeneratedConfig}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="190" FontFamily="Consolas" FontSize="11" />
                </StackPanel>
            </Border>
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
