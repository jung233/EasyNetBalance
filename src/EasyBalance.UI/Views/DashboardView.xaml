<UserControl x:Class="EasyBalance.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Width="275" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ROUTING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding RoutingStatusText}" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,3" />
                        <TextBlock Text="Traffic control runs in the Windows service" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleRoutingCommand}" Content="{Binding RoutingButtonText}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Width="275" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="SING-BOX CORE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Status.CoreState}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding Status.CoreState, Converter={StaticResource HealthBrushConverter}}" Margin="0,9,0,3" />
                        <TextBlock Text="{Binding Status.Version, StringFormat='Version {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Status.Uptime, StringFormat='Uptime {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Status.LastExitCode, StringFormat='Last exit code: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Width="275" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="NETWORK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Adapters.Count, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBlock Text="interfaces discovered" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="IPv4 and IPv6 health are independent" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Width="275">
                    <StackPanel>
                        <TextBlock Text="APPLICATION RULES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding RuleCount}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="application rules · " /><Run Text="{Binding Policies.Count, Mode=OneWay}" /><Run Text=" policies" /></TextBlock>
                        <TextBlock Text="Unmatched apps use the default policy" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="Network interfaces" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10" />
            <ItemsControl ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,12" Width="400">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="IPv4" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding IPv4Health}" Foreground="{Binding IPv4Health, Converter={StaticResource HealthBrushConverter}}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding IPv4Addresses}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding IPv4Gateways, StringFormat='Gateway: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding IPv4LatencyText, StringFormat='Latency: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="IPv6" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding IPv6Health}" Foreground="{Binding IPv6Health, Converter={StaticResource HealthBrushConverter}}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding IPv6Addresses}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding IPv6Gateways, StringFormat='Default route: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding IPv6LatencyText, StringFormat='Latency: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding LastProbeText, StringFormat='Last probe: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Policies" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Policies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ActiveIPv4, StringFormat='IPv4 · {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ActiveIPv6, StringFormat='IPv6 · {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Recent events" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding RecentEvents}" Height="220" IsReadOnly="True" RowHeight="31" ColumnHeaderHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="130" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="105" />
                                <DataGridTextColumn Header="Event" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding Status.LastError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
