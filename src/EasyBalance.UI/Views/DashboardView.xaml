<UserControl x:Class="EasyBalance.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,8">
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ROUTING" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="{Binding RoutingStatusText}" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,3" />
                        <TextBlock Text="Traffic control runs in the Windows service" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleRoutingCommand}" Content="{Binding RoutingButtonText}" HorizontalAlignment="Left" Margin="0,15,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <ProgressBar Width="34" Height="4" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Updating routing service…" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}" MaxHeight="38" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" MaxHeight="32" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="SING-BOX CORE" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="{Binding Status.CoreState}" FontSize="23" FontWeight="SemiBold" Foreground="{Binding Status.CoreState, Converter={StaticResource HealthBrushConverter}}" Margin="0,10,0,3" />
                        <TextBlock Text="{Binding Status.Version, StringFormat='Version {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Status.Uptime, StringFormat='Uptime {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Status.LastExitCode, StringFormat='Last exit code: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Status.LastError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status.LastError}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="NETWORK" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="{Binding Adapters.Count, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" Margin="0,9,0,1" />
                        <TextBlock Text="interfaces discovered" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="IPv4 and IPv6 health are independent" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="APPLICATION RULES" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="{Binding RuleCount}" FontSize="30" FontWeight="SemiBold" Margin="0,9,0,1" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="application rules · " /><Run Text="{Binding Policies.Count, Mode=OneWay}" /><Run Text=" policies" /></TextBlock>
                        <TextBlock Text="Unmatched apps use the default policy" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource SurfaceCard}" Padding="17" Margin="0,0,0,22">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Outbound traffic" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Per-interface byte counters reported by the service" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TelemetrySampledAt, StringFormat='Sampled {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                        <Border Style="{StaticResource MetricPanel}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Uploaded" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding UploadTotalText}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPanel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Downloaded" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DownloadTotalText}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding OutboundTraffic}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><primitives:UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="OutboundCard" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding InterfaceId, StringFormat='Interface · {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InterfaceId}" Margin="0,2,0,0" />
                                        <TextBlock x:Name="OutboundAvailability" Text="{Binding AvailabilityText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="UPLOAD" Style="{StaticResource EyebrowText}" />
                                                <TextBlock Text="{Binding UploadText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="DOWNLOAD" Style="{StaticResource EyebrowText}" />
                                                <TextBlock Text="{Binding DownloadText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"><Run Text="Connections · " /><Run Text="{Binding ActiveConnectionsText}" /><Run Text="  Target · " /><Run Text="{Binding TargetPercentText}" /></TextBlock>
                                        <TextBlock x:Name="OutboundError" Text="{Binding ErrorText, StringFormat='Error · {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorText}" MaxHeight="34" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                        <Setter TargetName="OutboundAvailability" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter TargetName="OutboundError" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter TargetName="OutboundCard" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter TargetName="OutboundAvailability" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter TargetName="OutboundError" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter TargetName="OutboundCard" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding OutboundTelemetryStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Network interfaces" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Live IPv4 and IPv6 health by adapter" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><primitives:UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SurfaceCard}" Padding="16" Margin="0,0,12,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,7,0">
                                            <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="{Binding SpeedText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MetricPanel}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="IPv4" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="{Binding IPv4Health}" Foreground="{Binding IPv4Health, Converter={StaticResource HealthBrushConverter}}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding IPv4Addresses}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv4Addresses}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding IPv4Gateways, StringFormat='Gateway: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv4Gateways}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding IPv4LatencyText, StringFormat='Latency: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource MetricPanel}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="IPv6" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="{Binding IPv6Health}" Foreground="{Binding IPv6Health, Converter={StaticResource HealthBrushConverter}}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding IPv6Addresses}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv6Addresses}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding IPv6Gateways, StringFormat='Default route: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv6Gateways}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding IPv6LatencyText, StringFormat='Latency: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding LastProbeText, StringFormat='Last probe: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="17" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Policies" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Policies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ActiveIPv4, StringFormat='IPv4 · {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding ActiveIPv6, StringFormat='IPv6 · {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="17" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Recent events" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding RecentEvents}" Height="220" IsReadOnly="True" RowHeight="31" ColumnHeaderHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="130" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="105" />
                                <DataGridTextColumn Header="Event" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
